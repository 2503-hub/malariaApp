# # Copy this file to backend/.env and set your Gemini API key.
# # Never put this key in Flutter or commit the .env file.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# # Optional overrides
# MAX_HISTORY=8
# GEMINI_MAX_TOKENS=700
# GEMINI_TEMPERATURE=0.2
# GEMINI_TIMEOUT_SECONDS=30
# JWT_SECRET_KEY=please-change-this-secret
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
